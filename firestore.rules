rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Korisnički profil - samo vlasnik sme da ga čita/menja.
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Napomena: kolekcije vehicles / serviceRecords (sa pravilima po userId
    // vlasništvu) dodaju se u narednim sprintovima. Do tada Firestore po
    // difoltu odbija pristup svemu što nije eksplicitno dozvoljeno gore.
  }
}
