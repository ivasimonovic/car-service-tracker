rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Korisnički profil - samo vlasnik sme da ga čita/menja.
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Vozila - korisnik sme da čita/menja/briše samo svoja vozila.
    match /vehicles/{vehicleId} {
      allow read, update, delete: if request.auth != null && request.auth.uid == resource.data.userId;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.userId;
    }

    // Istorija servisa - korisnik sme da čita/menja/briše samo servise koje je sam kreirao.
    match /serviceRecords/{recordId} {
      allow read, update, delete: if request.auth != null && request.auth.uid == resource.data.userId;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.userId;

      // Stavke servisa (podkolekcija) - userId je denormalizovan na svaku stavku
      // (umesto get() ka roditelju) da bi provera radila i unutar iste transakcije
      // koja kreira i roditeljski servis i stavke odjednom.
      match /items/{itemId} {
        allow read, update, delete: if request.auth != null && request.auth.uid == resource.data.userId;
        allow create: if request.auth != null && request.auth.uid == request.resource.data.userId;
      }
    }

    // Referentni katalozi (marke vozila, tipovi stavki servisa) - čitanje svim prijavljenim
    // korisnicima, upis samo preko admin/seed skripte (van aplikacije).
    match /vehicleBrands/{brandId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    match /serviceItemTypes/{itemTypeId} {
      allow read: if request.auth != null;
      allow write: if false;
    }
  }
}
